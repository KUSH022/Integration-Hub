# ---------------------------------------------------------------------------------------------
# KP Integration Hub backend configuration. Copy to server/.env for local development.
# PLACEHOLDERS ONLY — never commit real values. In hosted environments set these as
# environment variables / secrets in the hosting dashboard.
# ---------------------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Dedicated Hub database (never the KP WFM or KP QA Agent database).
MONGODB_URI=mongodb+srv://<hub-db-user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=kp_integration_hub

# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=<random-32+-chars>
SECRETS_ENCRYPTION_KEY=<32-byte-base64-key>
REFERENCE_SIGNING_SECRET=<random-32+-chars>
QA_AGENT_API_KEY=<shared-random-secret-for-local-QA-Agent>
CRON_SECRET=<random-secret-for-protected-Vercel-worker-tick>

SESSION_TTL_MINUTES=480
# Must be true in production (HTTPS). false only for http://localhost development.
COOKIE_SECURE=false

# Comma-separated frontend origin(s). REQUIRED even when /api is proxied (Vite dev proxy, Vercel/Render
# rewrites): browsers send an Origin header on POST/PUT/DELETE, and unlisted origins are rejected.
# Example production value: https://kp-hub.vercel.app . CORS is not authentication.
CORS_ORIGINS=http://localhost:5173

# Public HTTPS URL of this API. Enables signed expected-payload references for KP QA Agent.
PUBLIC_API_BASE_URL=

# Number of reverse proxies in front of the app (Render/Koyeb: 1).
TRUST_PROXY=1
JSON_BODY_LIMIT_KB=1024
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_15_MIN=20

# First-run only: creates an ADMIN when the users collection is empty. Remove the password afterwards.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=<at-least-12-characters>

# Outbound destination safety (SSRF). Keep ALLOW_PRIVATE_DESTINATIONS=false unless KP WFM / KP QA Agent
# run on a private network you control (e.g. local development on localhost).
ALLOW_PRIVATE_DESTINATIONS=false
# Defaults: true when NODE_ENV=production.
REQUIRE_HTTPS_DESTINATIONS=
# Defaults: 443 in production, any port otherwise. Example: 443,8443
ALLOWED_DESTINATION_PORTS=
# Optional hostname allowlist, e.g. kp-wfm.example.com,*.kp.example.com
DESTINATION_HOST_ALLOWLIST=

# Database-backed worker (runs inside the API process).
WORKER_ENABLED=true
WORKER_POLL_MS=2000
WORKER_CONCURRENCY=2
RUN_LEASE_SECONDS=300

# Retention in days (0 = keep forever). Implemented with MongoDB TTL indexes on new records.
RUN_RETENTION_DAYS=0
SOURCE_RETENTION_DAYS=0
AUDIT_RETENTION_DAYS=0
MAX_RECORDS_PER_SUBMISSION=500
