{
  "name": "@kp-hub/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/localServer.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/localServer.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "tsx scripts/export-openapi.ts",
    "start:local": "node --env-file=.env dist/src/localServer.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongodb": "^6.12.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
